# ──── Postgres (Neon) ────
# `neon link --project-id <id> --branch production -y` writes these three for you.
# Pooled endpoint (FastAPI via asyncpg; channel_binding/sslmode params handled automatically):
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct (unpooled) endpoint — preferred for migrations/tests:
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Branch name:
NEON_BRANCH=production
# Optional override for psycopg2 tools (pytest/seed/migrate); derived from
# DATABASE_URL_UNPOOLED when empty:
# DATABASE_URL_SYNC=

# ──── Redis (required for the Arq worker: queues, rate limits, cron) ────
REDIS_URL=redis://localhost:6379/0

# ──── Supabase Auth ────
# Generate a strong secret: openssl rand -base64 32
SUPABASE_JWT_SECRET=super-secret-jwt-key-for-local-dev-change-me
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
SUPABASE_URL=http://localhost:8000

# ──── Encryption ────
# AES-256-GCM key for encrypting CMS credentials and OAuth tokens
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=base64-encoded-32-byte-key-change-me

# ──── Service-to-service auth ────
# Shared token the Feeds edge worker sends as X-Internal-Service to /api/v1/clients/*/edge/*
# Generate: openssl rand -hex 32
EDGE_SERVICE_TOKEN=change-me-long-random

# ──── Stripe (billing webhook) ────
# Empty = /webhooks/stripe returns 503 (disabled). Set the whsec_... signing secret to enable.
STRIPE_WEBHOOK_SECRET=

# ---- Engine providers (empty = mock adapter; set a key for live collection) ----
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# ──── Object Storage (S3-compatible) ────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=footnote

# ──── API ────
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=debug

# ──── Sentry (optional) ────
SENTRY_DSN=

# ──── Next.js ────
NEXT_PUBLIC_API_URL=http://localhost:8000
