# ──── Postgres ────
DATABASE_URL=postgresql://postgres:postgres@db:5432/footnote
DATABASE_URL_TEST=postgresql://postgres:postgres@db:5432/footnote_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=footnote

# ──── Redis ────
REDIS_URL=redis://redis:6379/0

# ──── Supabase Auth ────
# Generate a strong secret: openssl rand -base64 32
SUPABASE_JWT_SECRET=super-secret-jwt-key-for-local-dev-change-me
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
SUPABASE_URL=http://localhost:8000

# ──── Encryption ────
# AES-256-GCM key for encrypting CMS credentials and OAuth tokens
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=base64-encoded-32-byte-key-change-me

# ──── Object Storage (S3-compatible) ────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=footnote

# ──── API ────
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=debug

# ──── Sentry (optional) ────
SENTRY_DSN=

# ──── Next.js ────
NEXT_PUBLIC_API_URL=http://localhost:8000
